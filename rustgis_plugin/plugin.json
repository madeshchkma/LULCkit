{
  "id": "lulckit",
  "name": "LULCkit",
  "version": "0.3.1",
  "description": "Turn any optical or pre-classified GeoTIFF into Cloud-Optimized LULC maps with named legends, multi-band COG exports, Sentinel-2/Landsat folder stacks, spectral indices (NDVI, NDWI, MNDWI, NDBI, SAVI, EVI, NBR), and print cartography.",
  "author": "Madesh Chakma",
  "homepage": "https://github.com/madeshchkma/LULCkit",
  "license": "MIT",
  "runtime": "process",
  "python": {
    "version": "3.12",
    "requirements": "requirements.txt"
  },
  "run": ["python", "main.py"],
  "minRustgisVersion": "0.8.0",
  "permissions": ["edit", "files"],
  "commands": [
    {
      "id": "load-output-raster",
      "label": "Load Last\nOutput",
      "help": "Load the latest LULCkit output GeoTIFF (or a specified path) directly onto the RustGIS map.",
      "icon": "add_data",
      "params": "{\"path\"?: \"string\", \"name\"?: \"string\"}",
      "form": [
        {
          "name": "path",
          "label": "GeoTIFF path (blank = latest LULCkit output)",
          "kind": "text",
          "required": false,
          "default": ""
        },
        {
          "name": "name",
          "label": "Layer name (optional)",
          "kind": "text",
          "required": false,
          "default": ""
        }
      ]
    },
    {
      "id": "inspect-active-raster",
      "label": "Inspect\nLayer",
      "help": "Profile an open RustGIS raster layer with LULCkit sensor fingerprinting and model recommendations.",
      "icon": "info",
      "params": "{\"layer\"?: \"string\"}",
      "form": [
        {
          "name": "layer",
          "label": "Raster layer",
          "kind": "rasterLayer",
          "required": false
        }
      ]
    },
    {
      "id": "models-info",
      "label": "Models &\nStyles",
      "help": "Show available LULCkit models, local cache status, palettes, and spectral indices.",
      "icon": "stats",
      "params": "{}"
    },
    {
      "id": "about",
      "label": "About\nLULCkit",
      "help": "Show LULCkit version, license, and documentation link.",
      "icon": "info",
      "params": "{}"
    }
  ],
  "tools": [
    {
      "id": "lulc-map",
      "name": "LULC Map & Classification",
      "summary": "Classify or style a GeoTIFF into a Cloud-Optimized LULC GeoTIFF with named legend (.aux.xml), area analytics, vector GeoJSON, print map, and optional HTML viewer.",
      "toolbox": "LULCkit",
      "params": [
        {
          "name": "input",
          "label": "Input GeoTIFF",
          "kind": "file",
          "mode": "path",
          "required": true,
          "extensions": ["tif", "tiff", "vrt", "jp2"]
        },
        {
          "name": "model",
          "label": "Model",
          "kind": "choice",
          "choices": ["auto", "categorical", "rgb-oem", "rgb-fast", "s2-dw"],
          "default": "auto"
        },
        {
          "name": "palette",
          "label": "Palette",
          "kind": "choice",
          "choices": [
            "default",
            "arcgis-crop",
            "esa-worldcover",
            "esri-lulc",
            "dynamic-world",
            "nlcd",
            "corine",
            "qgis-spectral",
            "arcgis-topo",
            "urban-heat",
            "hydrology",
            "ag-phenology",
            "vivid",
            "earth",
            "pastel",
            "colorblind",
            "viridis",
            "turbo",
            "RdYlGn",
            "Spectral"
          ],
          "default": "default"
        },
        {
          "name": "title",
          "label": "Map title",
          "kind": "text",
          "default": ""
        },
        {
          "name": "rgbBands",
          "label": "Custom RGB bands",
          "help": "Optional 3 comma-separated 1-based bands for RGB models, e.g. 4,3,2",
          "kind": "text",
          "default": ""
        },
        {
          "name": "s2Bands",
          "label": "Custom Sentinel-2 bands",
          "help": "Optional 9 comma-separated 1-based bands (B2,B3,B4,B5,B6,B7,B8,B11,B12) for s2-dw",
          "kind": "text",
          "default": ""
        },
        {
          "name": "hfModel",
          "label": "Custom Hugging Face model",
          "help": "Optional Hugging Face semantic segmentation repo ID (SegFormer, UPerNet, Mask2Former, DPT)",
          "kind": "text",
          "default": ""
        },
        {
          "name": "tta",
          "label": "4-way flip TTA",
          "help": "Average predictions over 4 flip augmentations for cleaner edges (slower)",
          "kind": "bool",
          "default": false
        },
        {
          "name": "sieveSize",
          "label": "Speckle sieve (min pixels)",
          "help": "Remove isolated class patches smaller than N pixels (0 = off)",
          "kind": "number",
          "default": 0
        },
        {
          "name": "classLabels",
          "label": "Class labels",
          "help": "Optional id:Label pairs, e.g. 0:Non Boro,1:Boro Rice",
          "kind": "text",
          "default": ""
        },
        {
          "name": "classColors",
          "label": "Class colors",
          "help": "Optional id:#RRGGBB pairs, e.g. 0:#f3f4f6,1:#15803d",
          "kind": "text",
          "default": ""
        },
        {
          "name": "pageSize",
          "label": "Print page size",
          "kind": "choice",
          "choices": ["a4", "a5", "a3", "letter", "legal", "square", "auto"],
          "default": "a4"
        },
        {
          "name": "orientation",
          "label": "Orientation",
          "kind": "choice",
          "choices": ["auto", "landscape", "portrait"],
          "default": "auto"
        },
        {
          "name": "arrowStyle",
          "label": "North arrow style",
          "kind": "choice",
          "choices": ["compass", "classic", "fancy", "minimal", "none"],
          "default": "compass"
        },
        {
          "name": "scalebarStyle",
          "label": "Scale bar style",
          "kind": "choice",
          "choices": ["arcgis", "alternating", "simple", "none"],
          "default": "arcgis"
        },
        {
          "name": "showGrid",
          "label": "Show coordinate grid",
          "kind": "bool",
          "default": true
        },
        {
          "name": "boundary",
          "label": "Boundary overlay",
          "kind": "polygonLayer",
          "required": false
        },
        {
          "name": "vectorOut",
          "label": "Export vector GeoJSON",
          "kind": "bool",
          "default": true
        },
        {
          "name": "minAreaPixels",
          "label": "Minimum polygon pixels",
          "help": "Filter vector polygons smaller than this pixel count",
          "kind": "number",
          "default": 4
        },
        {
          "name": "saveConfidence",
          "label": "Save confidence GeoTIFF",
          "kind": "bool",
          "default": false
        },
        {
          "name": "htmlOut",
          "label": "Export interactive MapLibre HTML",
          "kind": "bool",
          "default": false
        },
        {
          "name": "device",
          "label": "Compute device",
          "kind": "choice",
          "choices": ["auto", "cpu", "cuda", "mps"],
          "default": "auto"
        },
        {
          "name": "outputDir",
          "label": "Output folder",
          "help": "Output folder (defaults to <input_dir>/<stem>_lulckit)",
          "kind": "text",
          "default": ""
        }
      ]
    },
    {
      "id": "export-bands",
      "name": "Export & Split Raster Bands",
      "summary": "Export any band subset into a multi-band COG, split bands into single-band COGs, or export a stretched 8-bit visual RGBA COG.",
      "toolbox": "LULCkit",
      "params": [
        {
          "name": "input",
          "label": "Input GeoTIFF",
          "kind": "file",
          "mode": "path",
          "required": true,
          "extensions": ["tif", "tiff", "vrt", "jp2"]
        },
        {
          "name": "mode",
          "label": "Export mode",
          "kind": "choice",
          "choices": ["subset-stack", "split-bands", "visual-rgb"],
          "default": "subset-stack"
        },
        {
          "name": "bands",
          "label": "Bands (indices or names)",
          "help": "Comma-separated 1-based indices or band names (e.g. 4,3,2,8 or B4,B3,B2,B8; blank = all non-alpha bands)",
          "kind": "text",
          "default": ""
        },
        {
          "name": "composite",
          "label": "Composite preset (for visual-rgb or subset)",
          "kind": "choice",
          "choices": ["auto", "true-color", "false-color-nir", "agriculture", "swir"],
          "default": "auto"
        },
        {
          "name": "outputPath",
          "label": "Output GeoTIFF path (or folder for split-bands)",
          "help": "Optional output path; defaults beside the input file",
          "kind": "text",
          "default": ""
        }
      ]
    },
    {
      "id": "stack-bands",
      "name": "Stack Band Folder (S2 / Landsat)",
      "summary": "Align and stack per-band Sentinel-2 (.jp2/.tif) or Landsat C2 (.tif) files from a folder into one multi-band COG with wavelengths.",
      "toolbox": "LULCkit",
      "params": [
        {
          "name": "inputFolder",
          "label": "Folder of per-band files",
          "help": "Path to a Sentinel-2 .SAFE/granule folder or Landsat scene folder",
          "kind": "text",
          "required": true
        },
        {
          "name": "sensor",
          "label": "Sensor family",
          "kind": "choice",
          "choices": ["auto", "sentinel2", "landsat"],
          "default": "auto"
        },
        {
          "name": "cloudMask",
          "label": "Apply cloud mask (SCL / QA_PIXEL)",
          "kind": "bool",
          "default": false
        },
        {
          "name": "outputPath",
          "label": "Output multi-band COG path",
          "help": "Optional output path; defaults to <folder>/<folder_name>_stack.tif",
          "kind": "text",
          "default": ""
        }
      ]
    },
    {
      "id": "spectral-index",
      "name": "Bands & Spectral Indices",
      "summary": "Compute spectral indices (NDVI, NDWI, MNDWI, NDBI, SAVI, EVI, NBR), band composites, custom RGBs, or single-band maps.",
      "toolbox": "LULCkit",
      "params": [
        {
          "name": "input",
          "label": "Input GeoTIFF",
          "kind": "file",
          "mode": "path",
          "required": true,
          "extensions": ["tif", "tiff", "vrt", "jp2"]
        },
        {
          "name": "mode",
          "label": "Mode",
          "kind": "choice",
          "choices": ["index", "composite", "rgb", "band"],
          "default": "index"
        },
        {
          "name": "indexName",
          "label": "Spectral index",
          "kind": "choice",
          "choices": ["ndvi", "ndwi", "mndwi", "ndbi", "savi", "evi", "nbr"],
          "default": "ndvi"
        },
        {
          "name": "composite",
          "label": "Composite preset",
          "kind": "choice",
          "choices": ["true-color", "false-color-nir", "agriculture", "swir"],
          "default": "true-color"
        },
        {
          "name": "rgbBands",
          "label": "Custom RGB bands",
          "help": "Comma-separated 1-based bands for rgb mode, e.g. 4,3,2",
          "kind": "text",
          "default": ""
        },
        {
          "name": "singleBand",
          "label": "Single band index",
          "kind": "number",
          "default": 1
        },
        {
          "name": "palette",
          "label": "Colormap",
          "kind": "choice",
          "choices": ["auto", "RdYlGn", "Blues", "RdBu", "viridis", "gray"],
          "default": "auto"
        },
        {
          "name": "title",
          "label": "Map title",
          "kind": "text",
          "default": ""
        },
        {
          "name": "outputDir",
          "label": "Output folder",
          "help": "Output folder (defaults to <input_dir>/<stem>_lulckit)",
          "kind": "text",
          "default": ""
        }
      ]
    },
    {
      "id": "inspect-geotiff",
      "name": "Inspect GeoTIFF Metadata",
      "summary": "Profile a TIFF/GeoTIFF/VRT/JP2 (CRS, GSD, band stats, layout, and recommended LULCkit model).",
      "toolbox": "LULCkit",
      "params": [
        {
          "name": "input",
          "label": "Input GeoTIFF",
          "kind": "file",
          "mode": "path",
          "required": true,
          "extensions": ["tif", "tiff", "vrt", "jp2"]
        },
        {
          "name": "outputJson",
          "label": "Save JSON report to",
          "help": "Optional path to save the full JSON metadata report",
          "kind": "text",
          "default": ""
        }
      ]
    },
    {
      "id": "clip-raster",
      "name": "Clip GeoTIFF to Polygon",
      "summary": "Clip a georeferenced GeoTIFF to a polygon layer, preserving colormaps and metadata tags.",
      "toolbox": "LULCkit",
      "params": [
        {
          "name": "input",
          "label": "Input GeoTIFF",
          "kind": "file",
          "mode": "path",
          "required": true,
          "extensions": ["tif", "tiff", "vrt", "jp2"]
        },
        {
          "name": "boundary",
          "label": "Clip boundary",
          "kind": "polygonLayer",
          "required": true
        },
        {
          "name": "crop",
          "label": "Crop extent to boundary",
          "kind": "bool",
          "default": true
        },
        {
          "name": "outputPath",
          "label": "Output GeoTIFF path",
          "help": "Output GeoTIFF path (defaults to <input_dir>/<stem>_clipped.tif)",
          "kind": "text",
          "default": ""
        }
      ]
    }
  ],
  "tab": {
    "label": "LULCkit",
    "groups": [
      {
        "label": "LULC & Raster",
        "items": [
          "tool:lulc-map",
          "tool:export-bands",
          "tool:stack-bands",
          "tool:spectral-index",
          "tool:inspect-geotiff",
          "tool:clip-raster"
        ]
      },
      {
        "label": "Map & Info",
        "items": ["load-output-raster", "inspect-active-raster", "models-info", "about"]
      }
    ]
  }
}
